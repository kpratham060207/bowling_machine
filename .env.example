# =============================================================================
# Bowling Machine — Environment Variable Template
# =============================================================================
# Copy to .env and fill in values. NEVER commit .env to version control.
# =============================================================================

# --- Application ---
NODE_ENV=development
APP_NAME=bowling-machine

# =============================================================================
# PUBLIC / BROWSER-SAFE (may appear in Next.js client bundles)
# Prefix NEXT_PUBLIC_ exposes values to the browser — never put secrets here.
# =============================================================================

# Web app URL (used for OAuth redirectTo and post-auth redirects)
# Set this to the port Next.js actually uses (e.g. 3004 if 3000 is busy).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend API base URL (browser calls this with Bearer token from Supabase session)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Supabase project URL — safe for browser (public endpoint)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon key — safe for browser; respects Auth policies only
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# =============================================================================
# SERVER ONLY — never import into frontend, ESP32, or client bundles
# =============================================================================

# --- API (Fastify) ---
API_HOST=0.0.0.0
API_PORT=4000
API_LOG_LEVEL=info

# --- Database (PostgreSQL via Docker Compose) ---
DATABASE_URL=postgresql://bowling:changeme@localhost:5432/bowling_machine

# Supabase service role key — bypasses Auth; registration provisioning only on backend
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase JWT secret — verifies Bearer tokens on API requests (Project Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret

# Supabase anon key — used by API to read SSR session cookies for browser WebSocket auth
SUPABASE_ANON_KEY=your-anon-key

# --- Machine communication (Phase 1E) ---
MACHINE_COMMAND_TTL_MS=30000
MACHINE_CONTROL_LOCK_TTL_MS=1800000
MACHINE_HEARTBEAT_INTERVAL_MS=5000
MACHINE_HEARTBEAT_TIMEOUT_MS=15000
MACHINE_COMMAND_ACK_TIMEOUT_MS=10000

# --- ESP32 simulator (local dev) ---
SIMULATOR_BACKEND_URL=http://127.0.0.1:4000
SIMULATOR_MACHINE_ID=22222222-2222-4222-8222-222222222222
SIMULATOR_CONNECTION_SECRET=dev-simulator-secret-001
SIMULATOR_HEARTBEAT_MS=5000
# SIMULATOR_FAILURE_MODE=none|connection_loss|heartbeat_timeout|command_timeout|machine_fault|actuator_failure|wheel_spinup_failure|feeder_failure|emergency_stop

# --- Local development ---
LOCAL_NETWORK_MODE=true
