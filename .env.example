# =============================================================================
# Bowling Machine — Environment Variable Template
# =============================================================================
# Copy to .env and fill in values. NEVER commit .env to version control.
# Phase 1A: foundation only — services read these in later phases.
# =============================================================================

# --- Application ---
NODE_ENV=development
APP_NAME=bowling-machine

# --- Web (Next.js) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- API (Fastify) ---
API_HOST=0.0.0.0
API_PORT=4000
API_LOG_LEVEL=info

# --- Database (PostgreSQL via Docker Compose) ---
# Matches docker-compose.yml defaults
DATABASE_URL=postgresql://bowling:changeme@localhost:5432/bowling_machine

# --- Supabase Auth (Phase 1B+) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Machine communication (Phase 1B+) ---
MACHINE_WS_SECRET=generate-a-strong-random-secret
MACHINE_COMMAND_TTL_MS=30000

# --- Local development ---
LOCAL_NETWORK_MODE=true
