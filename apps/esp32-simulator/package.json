{
  "name": "@bowling-machine/esp32-simulator",
  "version": "0.0.0",
  "private": true,
  "description": "ESP32 machine simulator for local development — Phase 1B+",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "default": "./dist/lib.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@bowling-machine/api-contracts": "workspace:*",
    "@bowling-machine/shared": "workspace:*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@bowling-machine/config": "workspace:*",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
