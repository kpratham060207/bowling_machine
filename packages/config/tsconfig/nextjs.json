{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@bowling-machine/config/tsconfig/base",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "noEmit": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": true
  }
}
